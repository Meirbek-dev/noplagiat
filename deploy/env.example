# Copy to deploy/.env for local Compose use. Never commit deploy/.env.
#
# Values marked SECRET are placeholders for a local stack only. In production
# every one of them is injected from the deployment secret store - never from a
# committed file, never from a `docker build --build-arg`, never baked into an
# image layer (AGENTS.md §3, ADR-008 §2).

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Replace both placeholder passwords with the same URL-safe local secret.
POSTGRES_DB=noplagiat
POSTGRES_USER=noplagiat
# SECRET
POSTGRES_PASSWORD=replace-with-a-local-secret
# SECRET (embeds the password above)
APP_DATABASE_URL=postgres://noplagiat:replace-with-a-local-secret@postgres:5432/noplagiat

# ── Origin ──────────────────────────────────────────────────────────────────
# The externally visible nginx gateway origin.
#
# It must be an HTTPS origin in production: the session cookie is issued with
# the `Secure` attribute unconditionally (server/crates/api/src/auth/mod.rs), so
# a browser will accept it over `http://localhost` - treated as a secure
# context - but silently DISCARD it on a plain-HTTP host with a real name. A
# staging box on `http://staging.example/` therefore accepts a correct password
# and then behaves as if the sign-in simply did nothing. Terminate TLS in front
# of the gateway on every host that is not localhost.
GATEWAY_PORT=8080
APP_PUBLIC_BASE_URL=http://localhost:8080
RUST_LOG=info

# Where the Rust process binds INSIDE its container. Required - the server
# refuses to start without it, and docker-compose.yml sets it to 0.0.0.0:8080
# for you. It is listed here for deployments that do not use that compose file;
# binding to 127.0.0.1 inside a container makes the service unreachable from
# nginx, which lands as a gateway 502 rather than a startup error.
APP_LISTEN_ADDR=0.0.0.0:8080

# ── Authentication (ADR-017) ──────────────────────────────────────────────
# There is nothing to configure. Sign-in is a login name and a password held in
# the `users` table, and accounts are created with the `manage-users` CLI on the
# server host:
#
#   docker compose exec server manage-users create-user --username admin --role admin
#
# It prompts for the password with the terminal echo off. For an unattended
# provisioning run, set APP_ADMIN_PASSWORD in that command's environment
# instead - never pass a password as an argument, and never put one in this
# file.
#
# A deployment with no accounts logs a warning at startup and cannot be signed
# into. That is the intended state until an operator creates the first one.

# Session lifetime in seconds. Default 43200 (12 h). A value that is present but
# not a positive integer is a startup failure, never a silent fallback.
APP_SESSION_TTL_SECONDS=43200

# ── Ingest (ADR-008 §2, ADR-010) ────────────────────────────────────────────
# SECRET, AND UNLIKE THE OTHERS IT IS NOT ROTATABLE.
#
# `APP_INGEST_PEPPER` keys the HMAC that turns author and reviewer identifiers
# into the opaque refs the warehouse stores. Changing it re-keys every future
# derivation, so previously imported rows no longer join to newly imported ones:
# attempt ladders break, `staff_units` mappings stop matching, and the damage is
# silent - counts still add up, they are just wrong.
#
# Consequences: keep exactly one pepper per environment, for the life of the
# environment; keep it in the secret store and nowhere else (never in Git, never
# in the database, never in a log line); back it up with the database, because a
# restored dump is unreadable without the pepper that produced it.
# SECRET
APP_INGEST_PEPPER=replace-from-the-secret-store

# Bearer token for an API-kind ingest source. Absent is fine on a host that runs
# only the CSV backfill.
# SECRET
# APP_SOURCE_TOKEN=replace-from-the-secret-store

# /readyz reports `ingest_stale` (503) when the newest SUCCEEDED batch is older
# than this. Default 93600 = 26 h - the nightly 02:00 +05:00 tick plus two hours
# of slack, against TZ §3.3.3's daily-refresh requirement. A warehouse that has
# never been fed is ready, not stale (ADR-014 §9).
APP_INGEST_MAX_AGE_SECONDS=93600

# ── Reports (TZ §4.5, ADR-013, ADR-015 §7) ──────────────────────────────────
# Where immutable snapshots are written. Must be a persistent volume: a
# published report link has to keep resolving to the bytes that were published,
# and a container filesystem does not survive a redeploy. The compose file
# mounts the named `reports` volume here.
APP_REPORTS_DIR=/var/lib/noplagiat/reports

# ── Web (SSR) ───────────────────────────────────────────────────────────────
# Where the Node SSR process reaches the Rust API from inside the Compose
# network. Server-side fetches do not pass through the gateway (ADR-009).
API_ORIGIN=http://server:8080

# Keep VITE_API_BASE unset: browser requests use the gateway's same-origin /api
# path.
